rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Production: prefer custom claim role == platform_admin.
    // Email allowlist is a temporary bootstrap for Heuristic Labs admins
    // until all admin accounts have claims set via Admin SDK.
    function isPlatformAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'platform_admin' ||
        request.auth.token.email.matches('(?i)^(admin@voicera\\.ai|admin@vocera\\.ai|platform@heuristiclabs\\.ai|admin@heuristiclabs\\.ai)$')
      );
    }

    function isOrgMember(orgId) {
      return isSignedIn() && (
        request.auth.token.orgId == orgId ||
        (resource != null && resource.data.ownerUid == request.auth.uid) ||
        (resource != null && resource.data.email == request.auth.token.email)
      );
    }

    // Tenant isolation (maps to brief: RLS / ownership checks).
    // - Platform admins: full read/write for console management
    // - Customers: read only their own org (subscriptions, status)
    // - No authenticated user may create/update another tenant's org from the client
    match /organizations/{orgId} {
      allow get: if isPlatformAdmin() || isOrgMember(orgId);
      allow list: if isPlatformAdmin();
      allow create, update, delete: if isPlatformAdmin();
    }

    // Audit trail — writes only via Admin SDK (Cloud Functions).
    match /audit_events/{eventId} {
      allow get, list: if isPlatformAdmin() || (
        isSignedIn() && resource.data.orgId == request.auth.token.orgId
      );
      allow create, update, delete: if false;
    }

    // Default deny — all other collections are blocked unless explicitly opened.
  }
}
